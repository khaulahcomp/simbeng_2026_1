# ============================================================
# SIM-Bengkel - Proteksi & optimasi (Apache / cPanel shared hosting)
# Catatan: server preview memakai `php -S` yang mengabaikan .htaccess;
# aturan di bawah berlaku penuh di cPanel/Apache.
# ============================================================

# ---- Blokir akses langsung ke berkas & folder sensitif ----
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|md|sh|ini)$">
  Require all denied
</FilesMatch>

# Blokir skrip migrasi & administrasi dari akses web publik.
<FilesMatch "^(migrate_sqlite_to_mysql\.php)$">
  Require all denied
</FilesMatch>

# Lindungi folder includes, scripts, logs (jika .htaccess per-folder tak terbaca).
RedirectMatch 403 ^/(includes|scripts|logs)/.*$

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Kompresi (gzip) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Cache aset statis (aman: aset non-transaksi) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# ---- OPcache (bila diizinkan host) ----
<IfModule mod_php.c>
  php_flag opcache.enable On
</IfModule>
